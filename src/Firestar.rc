#include <windows.h>
#include "FirestarVersion.h"

// Runtime assets are embedded in Firestar.exe. No external assets folder is required.
1 ICON "..\\assets\\firestar.ico"
101 RCDATA "..\\assets\\DroidSans.ttf"
102 RCDATA "..\\assets\\firestar_menu.png"
103 RCDATA "..\\docs\\REPAK_ASSET_TYPES.md"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FIRESTAR_VERSION_COMMA
 PRODUCTVERSION FIRESTAR_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WateryContinent\0"
            VALUE "FileDescription", "Firestar\0"
            VALUE "FileVersion", FIRESTAR_VERSION_STRING "." FIRESTAR_UPDATE_NUMBER_STRING "\0"
            VALUE "InternalName", "Firestar\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 WateryContinent\0"
            VALUE "OriginalFilename", "Firestar.exe\0"
            VALUE "ProductName", "Firestar\0"
            VALUE "ProductVersion", FIRESTAR_VERSION_STRING " (" FIRESTAR_UPDATE_STRING ")\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
